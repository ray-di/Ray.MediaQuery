{
    "name": "ray/media-query",
    "description": "PHP interface-based SQL framework",
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-tokenizer": "*",
        "aura/sql": "^5.0 || ^6.0",
        "koriym/csv-entities": "^1.0",
        "koriym/null-object": "^1.0.1",
        "pagerfanta/pagerfanta": "^3.5 || ^4.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpdocumentor/type-resolver": "^2.0",
        "ray/aop": "^2.19",
        "ray/aura-sql-module": "^1.17",
        "ray/di": "^2.19",
        "ray/input-query": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Ray\\MediaQuery\\": [
                "src/",
                "src-deprecated/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ray\\MediaQuery\\": [
                "tests/",
                "tests/Fake"
            ],
            "Tutorial\\Blog\\": "docs/tutorial/src/Blog/"
        }
    },
    "scripts": {
        "coverage": "php -dzend_extension=xdebug.so -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage",
        "pcov": "php -dextension=pcov.so -d pcov.enabled=1 ./vendor/bin/phpunit --coverage-text --coverage-html=build/coverage  --coverage-clover=coverage.xml",
        "cs": "./vendor/bin/phpcs",
        "cs-fix": "./vendor/bin/phpcbf src tests docs/tutorial/src/Blog",
        "metrics": "./vendor/bin/phpmetrics --report-html=build/metrics --exclude=Exception src",
        "clean": [
            "./vendor/bin/phpstan clear-result-cache",
            "./vendor/bin/psalm --clear-cache"
        ],
        "sa": [
            "./vendor/bin/psalm --monochrome --show-info=true",
            "./vendor/bin/phpstan analyse -c phpstan.neon"
        ],
        "test": "./vendor/bin/phpunit",
        "tests": [
            "@cs",
            "@sa",
            "@test"
        ],
        "build": [
            "@clean",
            "@cs",
            "@sa",
            "@pcov",
            "@metrics"
        ]
    },
    "scripts-descriptions": {
        "test": "Run unit tests",
        "coverage": "Generate test coverage report",
        "pcov": "Generate test coverage report (pcov)",
        "cs": "Check the coding style",
        "cs-fix": "Fix the coding style",
        "clean": "Delete tmp files",
        "sa": "Run static analysis",
        "metrics": "Build metrics report",
        "tests": "Run tests and quality checks",
        "build": "Build project"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "bamarni/composer-bin-plugin": true
        },
        "audit": {
            "ignore": {
                "PKSA-5jz8-6tcw-pbk4": "PHPUnit dev-only dependency; PHP 8.2 support precludes PHPUnit 12",
                "PKSA-z3gr-8qht-p93v": "PHPUnit dev-only dependency; PHP 8.2 support precludes PHPUnit 12"
            }
        }
    },
    "suggest": {
        "koriym/csv-entities": "Provides one-to-many entity relation",
        "ray/web-query": "For Web API query support"
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "target-directory": "vendor-bin",
            "forward-command": true
        }
    }
}
